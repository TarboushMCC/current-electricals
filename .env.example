# ============================================================
# CurrentElectricals — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in the values

# ─── Site Config ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.currentelectricals.ae
NEXT_PUBLIC_SITE_NAME=CurrentElectricals
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── SMTP Mail (contact forms, quotations, careers) ─────────
SMTP_HOST=mail.currentelectricals.ae
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@currentelectricals.ae
SMTP_PASS=your_smtp_password
SMTP_FROM=info@currentelectricals.ae
SMTP_REPLY_TO=info@currentelectricals.ae

# ─── Contact Destinations ───────────────────────────────────
CONTACT_EMAIL_TO=info@currentelectricals.ae
CAREERS_EMAIL_TO=hr@currentelectricals.ae
QUOTE_EMAIL_TO=sales@currentelectricals.ae

# ─── Database (MySQL) ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=current_electricals
DB_USER=db_user
DB_PASS=db_password

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60000

# ─── Analytics (optional) ───────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── reCAPTCHA (optional) ───────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
